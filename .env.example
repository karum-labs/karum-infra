# Karum environment variables.
#
# Every variable read by any process in the stack, and which process reads it.
# The laptop starts with `make local` (no Docker). The demo VM runs
# `docker compose` from this same file. Copy it and fill in the required values:
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. It is gitignored, and a secret scan (gitleaks)
# fails the build if a Qloo or GCP credential lands in a tracked file.
#
# Within each section:
#   Required — set this. The process cannot call that API without it.
#   Optional — a default is already applied. Change it only to override.
#
# KARUM_API_HOST is not set here. `make demo-refresh` writes it on the VM
# as <reserved-ip>.sslip.io so Caddy can serve HTTPS. The laptop ignores it.

# ============================================================================
# gateway (karum-server) — Go + Gin API gateway
# ============================================================================

# --- Required --------------------------------------------------------------
# Database URI. The gateway uses it for campaigns, runs, evidence, and the
# judge account. There is no database container in Compose; this is always
# an external Postgres URI (local or hosted).
# Read by: gateway
POSTGRES_DSN=

# Google Places API key. The gateway uses it for address, hours, website, and
# open status.
# Read by: gateway
GOOGLE_PLACES_API_KEY=

# Google Routes API key. The gateway uses it to order the field-sales stops.
# Read by: gateway
GOOGLE_ROUTES_API_KEY=

# --- Optional --------------------------------------------------------------
# Host port published for the Flutter web app. Inside the container the
# gateway still listens on 8080; this only changes the host side of the mapping.
# Read by: Compose
GATEWAY_PORT=8080

# Build version stamped into /health and log lines.
# Read by: gateway
GATEWAY_VERSION=local

# Operational mode: live, fixture, or degraded. Presets with no stored run
# use the fixture pipeline in fixture mode and the live pipeline in live mode.
# Read by: gateway
GATEWAY_MODE=fixture

# gRPC dial targets. TASTE_ADDR and AI_ADDR stay the HTTP health addresses.
# Read by: gateway
TASTE_GRPC_ADDR=localhost:9091
AI_GRPC_ADDR=localhost:9092

# Browser CORS allow-list, comma-separated. When empty, the gateway accepts
# loopback origins (localhost and 127.0.0.1 on any port) for `make local`.
# Set the deployed client origin, e.g. https://karum-512016.web.app.
# Read by: gateway
CLIENT_ORIGIN=

# Geocoding API key. When empty, the gateway uses GOOGLE_PLACES_API_KEY.
# Read by: gateway
GOOGLE_GEOCODING_API_KEY=

# Hackathon judge login. true serves GET /health with hackathon_mode=true,
# enables POST /api/v1/auth/judge, and shows the judge banner. The public demo
# still works anonymously when this is false or when the judge stays signed out.
# Read by: gateway; the client reads the flag from the gateway.
HACKATHON_MODE=false

# Preseeded judge account. Set all three together. The gateway bcrypt-hashes the
# password before writing it to Postgres; the plaintext stays in .env locally
# and in Secret Manager in production. Never commit a real value.
# Read by: gateway
JUDGE_EMAIL=
JUDGE_PASSWORD=
JUDGE_DISPLAY_NAME=Karum Judge

# Opaque session lifetime, as a Go duration. Defaults to seven days.
# Read by: gateway
SESSION_TTL=168h

# Compose sets these itself. Override them only when you run the gateway
# outside Compose: TASTE_ADDR, AI_ADDR, REDIS_ADDR.

# ============================================================================
# service-taste (karum-service-taste) — Qloo
# ============================================================================

# --- Required --------------------------------------------------------------
# Qloo API key. Injected via secret manager in production. The hackathon key
# only works against the base URL below.
# Read by: service-taste
TASTE_QLOO_API_KEY=

# --- Optional --------------------------------------------------------------
# Qloo base URL for the hackathon key.
# Read by: service-taste
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-taste
TASTE_LOG_LEVEL=INFO

# Compose sets these itself. Override them only when you run taste outside
# Compose: TASTE_PORT, TASTE_REDIS_ADDR.

# ============================================================================
# service-ai (karum-service-ai) — Vertex AI and grounding
# ============================================================================

# --- Required --------------------------------------------------------------
# Gemini API key from Google AI Studio. Menu audits and pitch drafts use this
# key. It is not a credential of the Cloud project.
# Read by: service-ai
GEMINI_API_KEY=

# --- Optional --------------------------------------------------------------
# GCP project id for Vertex. Used only when GEMINI_API_KEY is empty.
# Read by: service-ai
AI_GCP_PROJECT_ID=

# GCP region hosting the Vertex endpoint. Ignored when GEMINI_API_KEY is set.
# Read by: service-ai
AI_GCP_LOCATION=us-central1

# Gemini model id used for menu audits and drafts.
# Read by: service-ai
AI_GEMINI_MODEL=gemini-2.5-flash

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-ai
AI_LOG_LEVEL=INFO

# Compose sets this itself. Override it only when you run the AI service
# outside Compose: AI_PORT.
