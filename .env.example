# Karum local-stack environment variables.
#
# Every variable read by any process in the stack, and which process reads it.
# All values have working defaults, so `docker compose up` boots the whole stack
# in fixture mode with no .env file present. Copy this to .env to override:
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. It is gitignored, and a secret scan (gitleaks)
# fails the build if a Qloo or GCP credential lands in a tracked file.

# ============================================================================
# Cross-cutting
# ============================================================================

# Operational mode for the gateway and both microservices: live, fixture, or
# degraded. Fixture replays recorded payloads and makes no outbound calls.
# Read by: gateway, service-taste, service-ai
GATEWAY_MODE=fixture
TASTE_MODE=fixture
AI_MODE=fixture

# ============================================================================
# gateway (karum-server) — Go + Gin API gateway
# ============================================================================

# Host port the gateway publishes. The Flutter web app points here.
# Read by: gateway (via compose port mapping)
GATEWAY_PORT=8080

# Build version stamped into /health and log lines.
# Read by: gateway
GATEWAY_VERSION=local

# NOTE: the gateway's TASTE_ADDR, AI_ADDR, REDIS_ADDR, and POSTGRES_DSN are set
# by docker-compose.yml to the compose service names. They only need overriding
# when running the gateway outside Compose.

# ============================================================================
# service-taste (karum-service-taste) — Qloo integration & scoring
# ============================================================================

# Qloo API key. Injected via secret manager in production. The hackathon key
# only works against the base URL below. Leave empty to stay in fixture mode.
# Read by: service-taste
TASTE_QLOO_API_KEY=

# Qloo base URL for the hackathon key.
# Read by: service-taste
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-taste
TASTE_LOG_LEVEL=INFO

# NOTE: TASTE_PORT and TASTE_REDIS_ADDR are set by docker-compose.yml to the
# in-stack values. Override only when running outside Compose.

# ============================================================================
# service-ai (karum-service-ai) — Vertex AI & pitch drafting
# ============================================================================

# GCP project id. Injected via secret manager in production. Leave empty to
# stay in fixture mode.
# Read by: service-ai
AI_GCP_PROJECT_ID=

# GCP region hosting the Vertex endpoint.
# Read by: service-ai
AI_GCP_LOCATION=us-central1

# Gemini model id used for grounded checks and drafting.
# Read by: service-ai
AI_GEMINI_MODEL=gemini-2.5-flash

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-ai
AI_LOG_LEVEL=INFO

# NOTE: AI_PORT is set by docker-compose.yml. Override only when running
# outside Compose.

# ============================================================================
# postgres — vacancies, runs, evidence snapshots, drafts
# ============================================================================

# Postgres superuser, password, and database created on first boot.
# Read by: postgres (init), gateway (via POSTGRES_DSN)
POSTGRES_USER=karum
POSTGRES_PASSWORD=karum
POSTGRES_DB=karum

# ============================================================================
# Not used by the local stack, but required for a live production deploy:
# ============================================================================

# Google Places API key — gateway enriches pins with address/hours/website.
# Read by: gateway
GOOGLE_PLACES_API_KEY=

# Google Routes API key — gateway computes the optional site-visit route.
# Read by: gateway
GOOGLE_ROUTES_API_KEY=
