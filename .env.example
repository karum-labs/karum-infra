# Karum local-stack environment variables.
#
# Every variable read by any process in the stack, and which process reads it.
# Copy this to .env and fill in the required values:
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. It is gitignored, and a secret scan (gitleaks)
# fails the build if a Qloo or GCP credential lands in a tracked file.
#
# Within each section:
#   Required — set this. The process cannot call that API without it.
#   Optional — a default is already applied. Change it only to override.

# ============================================================================
# gateway (karum-server) — Go + Gin API gateway
# ============================================================================

# --- Required --------------------------------------------------------------
# Database URI. The gateway uses it for campaigns, runs, evidence, and the
# judge account. There is no database container in Compose; this is always
# an external Postgres URI (local or hosted).
# Read by: gateway
POSTGRES_DSN=

# Google Places API key. The gateway uses it for address, hours, website, and
# open status.
# Read by: gateway
GOOGLE_PLACES_API_KEY=

# Google Routes API key. The gateway uses it to order the field-sales stops.
# Read by: gateway
GOOGLE_ROUTES_API_KEY=

# --- Optional --------------------------------------------------------------
# Host port published for the Flutter web app. Inside the container the
# gateway still listens on 8080; this only changes the host side of the mapping.
# Read by: Compose
GATEWAY_PORT=8080

# Build version stamped into /health and log lines.
# Read by: gateway
GATEWAY_VERSION=local

# Hackathon judge login. true shows a banner on the login screen that signs
# the judge into the preseeded account. false hides that banner.
# Read by: gateway; the client reads the flag from the gateway.
HACKATHON_MODE=false

# Compose sets these itself. Override them only when you run the gateway
# outside Compose: TASTE_ADDR, AI_ADDR, REDIS_ADDR.

# ============================================================================
# service-taste (karum-service-taste) — Qloo
# ============================================================================

# --- Required --------------------------------------------------------------
# Qloo API key. Injected via secret manager in production. The hackathon key
# only works against the base URL below.
# Read by: service-taste
TASTE_QLOO_API_KEY=

# --- Optional --------------------------------------------------------------
# Qloo base URL for the hackathon key.
# Read by: service-taste
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-taste
TASTE_LOG_LEVEL=INFO

# Compose sets these itself. Override them only when you run taste outside
# Compose: TASTE_PORT, TASTE_REDIS_ADDR.

# ============================================================================
# service-ai (karum-service-ai) — Vertex AI and grounding
# ============================================================================

# --- Required --------------------------------------------------------------
# GCP project id for Vertex. Injected via secret manager in production.
# Application Default Credentials must be able to see this project.
# Read by: service-ai
AI_GCP_PROJECT_ID=

# --- Optional --------------------------------------------------------------
# GCP region hosting the Vertex endpoint.
# Read by: service-ai
AI_GCP_LOCATION=us-central1

# Gemini model id used for menu audits and drafts.
# Read by: service-ai
AI_GEMINI_MODEL=gemini-2.5-flash

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-ai
AI_LOG_LEVEL=INFO

# Compose sets this itself. Override it only when you run the AI service
# outside Compose: AI_PORT.
