# Karum local-stack environment variables.
#
# Every variable read by any process in the stack, and which process reads it.
# Copy this to .env to override the defaults:
#
#   cp .env.example .env
#
# You can boot with no .env file at all. Compose fills anything you leave unset,
# and every service starts in fixture mode (recorded payloads, no outbound calls).
#
# NEVER commit a filled-in .env. It is gitignored, and a secret scan (gitleaks)
# fails the build if a Qloo or GCP credential lands in a tracked file.
#
# Within each section:
#   Required for live — set this before that service calls a real API.
#                       Leave it empty while the service stays on fixture.
#   Optional          — a default is already applied. Change it only to override.
#
# Each service has its own mode. They are three variables because the processes
# decide independently, and /health reports each one. Values: live, fixture, degraded.
#   fixture  — replay recordings, make no outbound calls. This is the local default.
#   live     — call the real API. That service's "required for live" key must be set.
#   degraded — an upstream failed; /health says so and the UI shows the banner.
# Taste can be live against Qloo while the AI service stays on fixture, or the reverse.

# ============================================================================
# gateway (karum-server) — Go + Gin API gateway
# ============================================================================

# --- Required for live -----------------------------------------------------
# Google Places API key. The gateway uses it for address, hours, website, and
# open status. Leave empty on fixture; doors still return with enrichment unknown.
# Read by: gateway
GOOGLE_PLACES_API_KEY=

# Google Routes API key. The gateway uses it to order the field-sales stops.
# Leave empty on fixture, or whenever you do not want a route; the door list
# still comes back.
# Read by: gateway
GOOGLE_ROUTES_API_KEY=

# --- Optional --------------------------------------------------------------
# fixture, live, or degraded. Reported on the gateway's /health.
# Read by: gateway
GATEWAY_MODE=fixture

# Host port published for the Flutter web app. Inside the container the
# gateway still listens on 8080; this only changes the host side of the mapping.
# Read by: Compose
GATEWAY_PORT=8080

# Build version stamped into /health and log lines.
# Read by: gateway
GATEWAY_VERSION=local

# Compose sets these itself. Override them only when you run the gateway
# outside Compose: TASTE_ADDR, AI_ADDR, REDIS_ADDR, POSTGRES_DSN.

# ============================================================================
# service-taste (karum-service-taste) — Qloo
# ============================================================================

# --- Required for live -----------------------------------------------------
# Qloo API key. Injected via secret manager in production. The hackathon key
# only works against the base URL below. Leave empty while TASTE_MODE=fixture.
# Read by: service-taste
TASTE_QLOO_API_KEY=

# --- Optional --------------------------------------------------------------
# fixture, live, or degraded. Set live only after TASTE_QLOO_API_KEY is set.
# Read by: service-taste
TASTE_MODE=fixture

# Qloo base URL for the hackathon key.
# Read by: service-taste
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-taste
TASTE_LOG_LEVEL=INFO

# Compose sets these itself. Override them only when you run taste outside
# Compose: TASTE_PORT, TASTE_REDIS_ADDR.

# ============================================================================
# service-ai (karum-service-ai) — Vertex AI and grounding
# ============================================================================

# --- Required for live -----------------------------------------------------
# GCP project id for Vertex. Injected via secret manager in production.
# Leave empty while AI_MODE=fixture.
# Read by: service-ai
AI_GCP_PROJECT_ID=

# --- Optional --------------------------------------------------------------
# fixture, live, or degraded. Set live only after AI_GCP_PROJECT_ID is set
# and Application Default Credentials can see that project.
# Read by: service-ai
AI_MODE=fixture

# GCP region hosting the Vertex endpoint.
# Read by: service-ai
AI_GCP_LOCATION=us-central1

# Gemini model id used for menu audits and drafts.
# Read by: service-ai
AI_GEMINI_MODEL=gemini-2.5-flash

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-ai
AI_LOG_LEVEL=INFO

# Compose sets this itself. Override it only when you run the AI service
# outside Compose: AI_PORT.

# ============================================================================
# postgres
# ============================================================================

# --- Optional --------------------------------------------------------------
# Superuser, password, and database created on first boot. Compose defaults
# all three to karum. If you change one, change the others to match; the
# gateway's connection string is built from these same values.
# Read by: postgres (init), gateway (via POSTGRES_DSN)
POSTGRES_USER=karum
POSTGRES_PASSWORD=karum
POSTGRES_DB=karum
