# Karum environment variables.
#
# Every variable read by any process in the stack, and which process reads it.
# The laptop starts with `make local` (no Docker). The demo VM runs
# `docker compose` from this same file. Copy it and fill in the required values:
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. It is gitignored, and a secret scan (gitleaks)
# fails the build if a Qloo or GCP credential lands in a tracked file.
#
# Within each section:
#   Required — set this. The process cannot call that API without it.
#   Optional — a default is already applied. Change it only to override.
#
# KARUM_API_HOST is not set here. `make demo-refresh` writes it on the VM
# as <reserved-ip>.sslip.io so Caddy can serve HTTPS. The laptop ignores it.

# ============================================================================
# gateway (karum-server) — Go + Gin API gateway
# ============================================================================

# --- Required --------------------------------------------------------------
# Database URI. The gateway uses it for campaigns, runs, evidence, and the
# judge account. There is no database container in Compose; this is always
# an external Postgres URI (local or hosted).
# Read by: gateway
POSTGRES_DSN=

# Google Places API key. The gateway uses it for address, hours, website, and
# open status.
# Read by: gateway
GOOGLE_PLACES_API_KEY=

# Google Routes API key. The gateway uses it to order the field-sales stops.
# Read by: gateway
GOOGLE_ROUTES_API_KEY=

# --- Optional --------------------------------------------------------------
# Port the gateway listens on inside the container. Compose pins it to 8080
# and Caddy publishes the public origin; on the laptop `make local` starts the
# gateway on this port directly.
# Read by: gateway
GATEWAY_PORT=8080

# HTTP server timeouts, as Go durations.
# Read by: gateway
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=0s
GATEWAY_SHUTDOWN_TIMEOUT=10s

# Per-dependency deadlines for one outbound RPC.
# Read by: gateway
GATEWAY_TASTE_TIMEOUT=8s
GATEWAY_AI_TIMEOUT=30s
GATEWAY_PLACES_TIMEOUT=5s
GATEWAY_ROUTES_TIMEOUT=15s

# Build version stamped into /health and log lines.
# Read by: gateway
GATEWAY_VERSION=local

# Operational mode: live, fixture, or degraded. The gateway has no separate
# fixture pipeline: a preset with a stored run serves that run in any mode, and
# a preset without one runs the live pipeline.
# Read by: gateway
GATEWAY_MODE=fixture

# gRPC dial targets. TASTE_ADDR and AI_ADDR stay the HTTP health addresses.
# Read by: gateway
TASTE_GRPC_ADDR=localhost:9091
AI_GRPC_ADDR=localhost:9092

# Browser CORS allow-list, comma-separated. When empty, the gateway accepts
# loopback origins (localhost and 127.0.0.1 on any port) for `make local`.
# Set the deployed client origin, e.g. https://karum-512016.web.app.
# Read by: gateway
CLIENT_ORIGIN=

# Geocoding API key. When empty, the gateway uses GOOGLE_PLACES_API_KEY.
# Read by: gateway
GOOGLE_GEOCODING_API_KEY=

# Hackathon judge login. true enables POST /api/v1/auth/judge and reports
# hackathon_mode on GET /health. The login banner is a separate client build
# flag, SHOW_JUDGES_BANNER. The public demo still works anonymously when this
# is false.
# Read by: gateway
HACKATHON_MODE=false

# Preseeded judge account. Set all three together. The gateway bcrypt-hashes the
# password before writing it to Postgres; the plaintext stays in .env locally
# and in Secret Manager in production. Never commit a real value.
# Read by: gateway
JUDGE_EMAIL=
JUDGE_PASSWORD=
JUDGE_DISPLAY_NAME=Karum Judge

# Browser key for the Maps JavaScript API. `make local` and `make demo-refresh`
# pass it to Flutter as --dart-define=GOOGLE_MAPS_WEB_KEY. Restrict the key to
# maps-backend.googleapis.com and to the site origins. Empty falls back to
# CARTO tiles of OpenStreetMap data.
# Read by: client
GOOGLE_MAPS_WEB_KEY=

# Opaque session lifetime, as a Go duration. Defaults to seven days.
# Read by: gateway
SESSION_TTL=168h

# Compose sets these itself. Override them only when you run the gateway
# outside Compose: TASTE_ADDR, AI_ADDR, REDIS_ADDR.

# ============================================================================
# service-taste (karum-service-taste) — Qloo
# ============================================================================

# --- Required --------------------------------------------------------------
# Qloo API key. Injected via secret manager in production. The hackathon key
# only works against the base URL below.
# Read by: service-taste
TASTE_QLOO_API_KEY=

# --- Optional --------------------------------------------------------------
# Qloo base URL for the hackathon key.
# Read by: service-taste
TASTE_QLOO_BASE_URL=https://hackathon.api.qloo.com

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-taste
TASTE_LOG_LEVEL=INFO

# Operational mode: live, fixture, or degraded; reported on /health. In
# fixture mode the Qloo calls are served from the fixture pack, so the service
# makes no outbound Qloo call.
# Read by: service-taste
TASTE_MODE=fixture

# The fixture pack root, used in fixture mode. Relative paths resolve against
# the service-taste repository root; the pack ships in karum-infra.
# Read by: service-taste
TASTE_FIXTURES_DIR=../karum-infra/fixtures

# Qloo client tuning: per-request timeout, retries, the request budget, and
# the exponential backoff base.
# Read by: service-taste
TASTE_QLOO_TIMEOUT_SECONDS=10
TASTE_QLOO_MAX_RETRIES=3
TASTE_QLOO_RPS=5
TASTE_QLOO_BACKOFF_BASE_SECONDS=0.5

# Cache TTL in seconds (24h) and the maximum parallel outbound Qloo calls.
# Read by: service-taste
TASTE_CACHE_TTL_SECONDS=86400
TASTE_FANOUT_CAP=4

# Compose sets these itself: TASTE_PORT, TASTE_GRPC_PORT, TASTE_REDIS_ADDR,
# TASTE_SERVICE_NAME. Set TASTE_HOST only when you run taste outside Compose
# (it defaults to 0.0.0.0, which the container needs so the gateway can dial
# it over the Compose network).

# ============================================================================
# service-ai (karum-service-ai) — Gemini and grounding
# ============================================================================

# --- Required --------------------------------------------------------------
# A model credential: set one of AI_GEMINI_API_KEY and AI_GCP_PROJECT_ID.
# The service refuses to call the model with neither, and the key is never
# sent to the browser.
#
# AI_GEMINI_API_KEY is a Google AI Studio key. The call does not use Vertex or
# AI_GCP_PROJECT_ID when it is set, and it does not bill the Cloud project.
# GEMINI_API_KEY is still accepted as the legacy spelling.
# Read by: service-ai
AI_GEMINI_API_KEY=

# --- Optional --------------------------------------------------------------
# GCP project id for Vertex AI, used only when AI_GEMINI_API_KEY is empty.
# Read by: service-ai
AI_GCP_PROJECT_ID=

# GCP region hosting the Vertex endpoint. Ignored when AI_GEMINI_API_KEY is set.
# Read by: service-ai
AI_GCP_LOCATION=us-central1

# Gemini model id used for menu audits and drafts.
# Read by: service-ai
AI_GEMINI_MODEL=gemini-3.8-flash

# Structured log level: DEBUG, INFO, WARNING, or ERROR.
# Read by: service-ai
AI_LOG_LEVEL=INFO

# Operational mode: live, fixture, or degraded; reported on /health. In
# fixture mode the model calls are served from the recorded pack, so the
# service makes no outbound model call and needs no credential.
# Read by: service-ai
AI_MODE=fixture

# The recorded model pack, used in fixture mode. Relative paths resolve
# against the service-ai repository root; the pack ships in karum-infra.
# Read by: service-ai
AI_FIXTURES_DIR=../karum-infra/fixtures/ai

# Per-request model timeout in seconds, the output-token cap per draft, and
# the number of retries when a response fails schema validation.
# Read by: service-ai
AI_MODEL_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_SCHEMA_RETRY_LIMIT=1

# Maximum number of doors one menu audit may ground, and the bounded number
# of follow-up taste probes a run may request.
# Read by: service-ai
AI_GROUNDING_SHORTLIST_CAP=5
AI_PROBE_BUDGET=3

# Compose sets these itself: AI_PORT, AI_GRPC_PORT, AI_SERVICE_NAME. Set
# AI_HOST only when you run the AI service outside Compose (it defaults to
# 0.0.0.0, which the container needs so the gateway can dial it over the
# Compose network).
