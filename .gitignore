# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
service-account*.json

# Generated proto stubs (emitted by `make generate`, not committed)
proto/gen/

# Tool / build caches
.buf/
*.out
coverage.out

# IDE / editor
.idea/

# VS Code: share the team settings with the repo, keep personal launch
# configurations and tasks out of it.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Scratch space created by local tooling; never commit it.
.freebuff/
*.swp
*.swo
.DS_Store
