# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
service-account*.json

# Generated proto stubs and descriptor sets (emitted by `make generate`, not
# committed)
gen/

# Tool / build caches
.buf/
*.out
coverage.out

# IDE / editor
.idea/

# VS Code: share the team settings with the repo, keep personal launch
# configurations and tasks out of it.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Scratch space created by local tooling; never commit it.
.freebuff/
*.swp
*.swo
.DS_Store

# Spike runner — raw Qloo responses and resolved entity ids stay local.
spike/out/
spike/state.json

# Contract-test artifacts (binaries emitted during the stub round-trip).
contract/.out/

# Python bytecode
__pycache__/

# Local virtualenvs (proto contract test, spikes).
.venv/

# PID files and logs from `make local`. Never commit them.
.local/
