# Karum toolchain version pins.
#
# This file is the single source of truth for every toolchain version across the
# five repos. Each repo's CI and README reference these pins so laptops and CI
# always agree.
#
#   kaarum-infra/       this repo — protos, Compose, Cloud Run, pins
#   karum-client/       Flutter web + desktop
#   karum-server/       Go + Gin API gateway
#   karum-service-taste/ Python FastAPI (Qloo)
#   karum-service-ai/    Python FastAPI (Vertex AI)
#
# Bump a version here first, then update the consuming repo's own pin (go.mod
# toolchain, .python-version, pubspec environment).

# --- Go (karum-server) ----------------------------------------------------
# Gin v1.12 requires Go >= 1.25; the gateway module targets 1.26.
GO_VERSION=1.26.0

# --- Python (karum-service-taste, karum-service-ai) -----------------------
# Both microservices target CPython 3.13 and manage deps with uv.
PYTHON_VERSION=3.13
UV_VERSION=0.13.1

# --- Flutter (karum-client) -----------------------------------------------
# Flutter stable; Dart ships with it.
FLUTTER_VERSION=3.47.6
DART_VERSION=3.13.5

# --- Protobuf / buf (kaarum-infra) ---------------------------------------
BUF_VERSION=1.73.0

# --- Containers ------------------------------------------------------------
# Base images referenced by the Dockerfiles and Compose.
ALPINE_VERSION=3.21
DEBIAN_SLIM_VERSION=bookworm-slim
REDIS_VERSION=7-alpine
POSTGRES_VERSION=16-alpine
